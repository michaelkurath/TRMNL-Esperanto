<div class="layout layout--full"><div class="esperanto">
  <div class="esperanto__top"><span class="esperanto__brand">★ ESPERANTO</span><span class="esperanto__tag">{{ chosen_mode | upcase }} · {{ chosen_level | upcase }}</span></div>
  {% if pool_count > 0 %}
  <div class="esperanto__main">
    <div class="esperanto__word">{{ entry.word | escape }}</div>
    <div class="esperanto__meaning">{{ translation | escape }}</div>
  </div>
  <div class="esperanto__example">{{ entry.example_eo | escape }}</div>
  <div class="esperanto__example-translation">{{ example_translation | escape }}</div>
  <div class="esperanto__footer"><span class="esperanto__note">{{ note_translation | escape }}</span><span>VORTO DE LA TAGO</span></div>
  {% else %}<div class="esperanto__main">No entries for this level.</div>{% endif %}
</div></div>