{% comment %}TRMNL prepends Shared to every view.{% endcomment %}
{% assign chosen_mode = content_mode | default: 'mixed' %}
{% assign chosen_lang = translation_language | default: 'en' %}
{% assign chosen_level = difficulty | default: 'beginner' %}
{% assign day_number = 'now' | date: '%j' | plus: 0 %}
{% assign parity = day_number | modulo: 2 %}
{% if chosen_mode == 'mixed' %}
  {% if parity == 0 %}{% assign chosen_mode = 'learn' %}{% else %}{% assign chosen_mode = 'discover' %}{% endif %}
{% endif %}
{% if chosen_mode == 'discover' %}
  {% assign pool = discover | where: 'level', chosen_level %}
{% else %}
  {% assign pool = learn | where: 'level', chosen_level %}
{% endif %}
{% assign pool_count = pool.size %}
{% if pool_count > 0 %}
  {% assign item_index = day_number | minus: 1 | divided_by: 2 | modulo: pool_count %}
  {% if content_mode == 'learn' or content_mode == 'discover' %}
    {% assign item_index = day_number | minus: 1 | modulo: pool_count %}
  {% endif %}
  {% assign entry = pool[item_index] %}
  {% assign translation = entry.translations[chosen_lang] | default: entry.translations.en %}
  {% assign example_translation = entry.examples[chosen_lang] | default: entry.examples.en %}
  {% assign note_translation = entry.notes[chosen_lang] | default: entry.notes.en %}
{% endif %}
<style>
  .esperanto { color:#111; background:#fff; font-family:Inter,Arial,sans-serif; display:flex; flex-direction:column; height:100%; box-sizing:border-box; overflow:hidden; padding:12px 17px; }
  .esperanto * { box-sizing:border-box; }
  .esperanto__top { display:flex; align-items:center; justify-content:space-between; border-bottom:2px solid #111; padding-bottom:9px; gap:10px; }
  .esperanto__brand { font-size:20px; font-weight:800; letter-spacing:1px; }
  .esperanto__tag { font-size:12px; font-weight:700; text-transform:uppercase; }
  .esperanto__main { flex:1; min-height:0; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; gap:8px; padding:8px 3px; }
  .esperanto__word { font-size:62px; font-weight:800; line-height:1.04; overflow-wrap:anywhere; }
  .esperanto__meaning { font-size:25px; line-height:1.2; }
  .esperanto__example { border-top:1px solid #111; padding-top:12px; font-size:23px; font-weight:700; }
  .esperanto__example-translation { font-size:18px; margin-top:4px; }
  .esperanto__footer { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; border-top:2px solid #111; padding-top:10px; font-size:14px; }
  .esperanto__note { max-width:78%; line-height:1.25; }
  .esperanto--compact { padding:8px 12px; }
  .esperanto--compact .esperanto__brand { font-size:15px; }
  .esperanto--compact .esperanto__tag { font-size:10px; }
  .esperanto--compact .esperanto__top { padding-bottom:5px; border-bottom-width:1px; }
  .esperanto--compact .esperanto__word { font-size:38px; }
  .esperanto--compact .esperanto__meaning { font-size:17px; }
  .esperanto--compact .esperanto__footer { font-size:11px; padding-top:5px; border-top-width:1px; }
  .esperanto--compact .esperanto__example { font-size:16px; padding-top:5px; }
  .esperanto--compact .esperanto__example-translation { font-size:12px; }
  .esperanto--tiny .esperanto__word { font-size:30px; }
  .esperanto--tiny .esperanto__meaning { font-size:15px; }
</style>
