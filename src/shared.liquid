{% comment %}TRMNL prepends Shared to every view.{% endcomment %}
{% assign settings = trmnl.plugin_settings.custom_fields_values %}
{% assign content_mode = settings.content_mode | default: content_mode | default: 'mixed' %}
{% assign chosen_mode = content_mode %}
{% assign chosen_lang = settings.translation_language | default: translation_language | default: 'en' %}
{% assign chosen_level = settings.difficulty | default: difficulty | default: 'beginner' %}
{% assign lesson_day = rotation_day | default: day_number | default: 1 | plus: 0 %}
{% assign parity = lesson_day | modulo: 2 %}
{% if chosen_mode == 'mixed' %}
  {% if parity == 0 %}{% assign chosen_mode = 'learn' %}{% else %}{% assign chosen_mode = 'discover' %}{% endif %}
{% endif %}
{% if chosen_mode == 'discover' %}
  {% assign pool = discover | where: 'level', chosen_level %}
{% else %}
  {% assign pool = learn | where: 'level', chosen_level %}
{% endif %}
{% assign pool_count = pool.size %}
{% if pool_count > 0 %}
  {% assign item_index = lesson_day | minus: 1 | divided_by: 2 | modulo: pool_count %}
  {% if content_mode == 'learn' or content_mode == 'discover' %}
    {% assign item_index = lesson_day | minus: 1 | modulo: pool_count %}
  {% endif %}
  {% assign entry = pool[item_index] %}
  {% assign translation = entry.translations[chosen_lang] | default: entry.translations.en %}
  {% assign example_translation = entry.examples[chosen_lang] | default: entry.examples.en %}
  {% assign note_translation = entry.notes[chosen_lang] | default: entry.notes.en %}
{% endif %}
{% capture esperanto_title_bar %}
<div class="title_bar">
  <svg class="image" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 1.5 14.8 8.1 22 8.8 16.5 13.6 18.1 20.6 12 17 5.9 20.6 7.5 13.6 2 8.8 9.2 8.1Z"/>
  </svg>
  <span class="title">Esperanto</span>
  <span class="instance">{{ chosen_mode | capitalize | escape }}<span class="portrait:hidden"> · {{ chosen_level | capitalize | escape }}</span></span>
</div>
{% endcapture %}
