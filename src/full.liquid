<div class="layout layout--col gap--large text--center">
  {% if pool_count > 0 %}
    <div class="flex flex--col flex--center gap--none w--full">
      <span class="value value--xlarge lg:value--xxxlarge text--bold" data-value-fit="true" lang="eo">{{ entry.word | escape }}</span>
      <span class="value value--small lg:value--base" lang="{{ chosen_lang | escape }}">{{ translation | escape }}</span>
    </div>
    <div class="flex flex--col flex--center gap--none w--full">
      <span class="value value--small text--bold" lang="eo">{{ entry.example_eo | escape }}</span>
      <span class="description" lang="{{ chosen_lang | escape }}">{{ example_translation | escape }}</span>
    </div>
    <p class="label label--base m--0" lang="{{ chosen_lang | escape }}">{{ note_translation | escape }}</p>
  {% else %}
    <span class="label">No lesson data available.</span>
  {% endif %}
</div>
{{ esperanto_title_bar }}
